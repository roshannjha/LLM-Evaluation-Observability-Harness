# Copy to .env and fill in. Local mode (default) needs NONE of these.

# --- Embeddings & generation backend -------------------------------------
# EMBEDDING_BACKEND: "local" (default, no key) or "openai"
EMBEDDING_BACKEND=local
# LOCAL embedding model (HuggingFace); used when EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM_BACKEND: "openai" or "grok" (both OpenAI-compatible APIs)
LLM_BACKEND=openai
GENERATION_MODEL=gpt-4o-mini

# --- API keys (only needed for the phase you're running) -----------------
OPENAI_API_KEY=
# Grok (xAI) — OpenAI-compatible; set base URL if using Grok as generator
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Judge model for RAGAS / DeepEval metrics (keep this strong for good scores)
JUDGE_MODEL=gpt-4o-mini

# --- Langfuse tracing (Phase 6) ------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Quality gates (Phase 4/5) -------------------------------------------
FAITHFULNESS_MIN=0.90
TOXICITY_MAX=0.05
